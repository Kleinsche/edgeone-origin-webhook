# 复制为 .env（本地调试用），并在 EdgeOne Makers 控制台 -> 项目设置 -> 环境变量 中配置同样变量

# 必填：腾讯云 API 密钥，在 https://console.cloud.tencent.com/cam/capi 获取
# 建议只授予 QcloudTEOFullAccess 或自定义最小权限策略
EO_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxx
EO_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 必填：EdgeOne 站点 ID（控制台站点概览处获取），形如 zone-2xxxxxxxxx
# 作为默认站点；调用方可在请求体传 zoneId 覆盖
EO_ZONE_ID=zone-225qgrnvbi9w

# 可选：Webhook 调用令牌。配置后请求需携带令牌，以下三种位置任一均可：
#   X-Webhook-Token 头 / Authorization: Bearer <token> 头 / 请求体或 query 的 token 字段
# WEBHOOK_TOKEN=your-strong-random-token

# 可选：允许操作的域名白名单，逗号分隔，支持通配子域
# EO_ALLOWED_DOMAINS=*.example.com,assets.example.com

# 可选：允许操作的站点白名单，逗号分隔；不设置时不限制请求体传入的 zoneId
# EO_ALLOWED_ZONE_IDS=zone-225qgrnvbi9w

# 可选：多源站地址分隔符，默认 ","
# EO_ORIGIN_SEPARATOR=,

# 可选：API 接入点与超时
# EO_API_ENDPOINT=https://teo.tencentcloudapi.com
# EO_API_TIMEOUT_MS=15000

# 可选：允许用 GET 触发更新，便于 Lucky 等只能拼接 URL 的调用方，默认关闭
# EO_ALLOW_GET_UPDATE=true

# 可选：开放 GET 查询单个域名的回源配置。默认关闭，仅建议排障时临时开启
# EO_ALLOW_DESCRIBE=true

# 可选：允许的跨域来源。不设置时不返回 Access-Control-Allow-Origin，即不开放跨域
# EO_CORS_ORIGIN=https://example.com
